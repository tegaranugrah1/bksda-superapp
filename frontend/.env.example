# =============================================================================
# BKSDA SuperApp — Frontend Environment Variables
# =============================================================================
# Salin file ini ke .env.local untuk development lokal:
# cp .env.example .env.local
# =============================================================================

# URL Endpoint Backend API Laravel (Default Local: http://localhost:8000/api)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# URL Storage Media / Berkas Publik (RustFS S3 lokal atau Local Storage)
NEXT_PUBLIC_STORAGE_URL=http://localhost:9002/bksda

# WebSocket Laravel Reverb (Opsional untuk realtime live sync)
# NEXT_PUBLIC_REVERB_APP_KEY=bksda-reverb-key
