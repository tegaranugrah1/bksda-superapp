# Hermes Agent Environment Configuration
PORT=3000
NODE_ENV=production

# Operator-only QR page. Set a unique password; blank disables both QR routes.
# Use the existing HTTPS ingress for browser access. Never reuse webhook keys.
ASSISTANT_ADMIN_USERNAME=admin
ASSISTANT_ADMIN_PASSWORD=

# Proxmox LAN IP SuperApp Produksi (VM 106)
SUPERAPP_API_URL=http://192.168.100.203
SUPERAPP_INTERNAL_KEY=

# WhatsApp Gateway (Evolution API)
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=
# Configure the Evolution producer to send this as X-Evolution-Webhook-Key.
# Setting this variable configures the receiver; producer headers require setup too.
EVOLUTION_WEBHOOK_KEY=
EVOLUTION_INSTANCE_NAME=bksda-assistant

# Redis Session & Debounce
REDIS_HOST=redis
REDIS_PORT=6379

# Google Gemini AI Pro API Key
GEMINI_API_KEY=your_gemini_pro_api_key_here
