# BKSDA SuperApp - Mobile Client Environment Variables
# Copy this file to .env or .env.local to configure your local setup.

# Base URL of the Laravel Backend API (e.g. http://localhost:8000/api or https://api.example.com/api)
EXPO_PUBLIC_API_URL=http://localhost:8000/api

# Application Environment (development, staging, production)
EXPO_PUBLIC_APP_ENV=development
