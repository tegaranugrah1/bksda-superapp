FROM bksda-security-sandbox:php84
COPY --from=node:22-bookworm-slim /usr/local/bin/node /usr/local/bin/node
RUN apt-get update && apt-get install -y --no-install-recommends chromium && rm -rf /var/lib/apt/lists/*
COPY --from=node:22-bookworm-slim /usr/local/lib/node_modules/npm /opt/npm
RUN node /opt/npm/bin/npm-cli.js install --prefix /opt/browser-toolchain --ignore-scripts --no-audit --no-fund --package-lock=false @next/swc-linux-x64-gnu@16.4.2 @tailwindcss/oxide-linux-x64-gnu@4.2.4 lightningcss-linux-x64-gnu@1.32.0 && rm -rf /root/.npm
RUN docker-php-ext-install -j2 pcntl
COPY --from=phpdeps / /app/vendor/
COPY --from=nodedeps / /frontend/node_modules/
WORKDIR /scratch
